name: Build RAB Bengkel Las APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract project ZIP
        run: unzip -q RAB_Bengkel_Las_Android_Project_HP.zip

      - name: Install Gradle
        run: |
          curl -fsSL https://services.gradle.org/distributions/gradle-8.9-bin.zip -o /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /tmp
          echo "/tmp/gradle-8.9/bin" >> "$GITHUB_PATH"

      - name: Build APK
        run: gradle --no-daemon -p RAB_Bengkel_Las_Android assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: RAB-Bengkel-Las-APK
          path: RAB_Bengkel_Las_Android/app/build/outputs/apk/debug/app-debug.apk
# trigger workflow
